# Google Gemini API key — get one at https://aistudio.google.com/apikey
# Copy this file to .env.local and fill in your key.
# If left empty, the app runs in MOCK mode (deterministic fake grading),
# so you can still demo the full flow without an API key.
GEMINI_API_KEY=

# Optional: override the model used for grading + tutoring.
# Defaults to a current multimodal Gemini Flash model (vision-capable).
GEMINI_MODEL=gemini-3.6-flash
