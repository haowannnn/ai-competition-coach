# Anthropic Claude API key — get one at https://console.anthropic.com/
# Copy this file to .env.local and fill in your key.
# If left empty, the app runs in MOCK mode (deterministic fake grading),
# so you can still demo the full flow without an API key.
ANTHROPIC_API_KEY=

# Optional: override the model used for grading.
# Defaults to a current multimodal Claude model.
ANTHROPIC_MODEL=claude-sonnet-4-6
